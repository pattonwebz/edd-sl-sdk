<?xml version="1.0"?>
<phpunit
	bootstrap="tests/Bootstrap.php"
	colors="true"
	backupGlobals="false"
>
	<testsuites>
		<testsuite name="Unit">
			<directory suffix="Test.php">./tests/</directory>
		</testsuite>
	</testsuites>
	<coverage>
		<include>
			<directory suffix=".php">./src/</directory>
		</include>
	</coverage>
</phpunit>
